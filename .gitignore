# Build output. These used to be committed — ~694 MB of zips that every clone
# pays for forever. They live in GitHub Release assets now, which are stored
# outside git object storage and cost nothing.
#   npm run release:archive            # show the plan
#   npm run release:archive -- --yes   # tag, create releases, upload
releases/
