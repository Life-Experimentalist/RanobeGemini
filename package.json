{
	"name": "ranobe-gemini",
	"version": "5.1.0",
	"description": "Local-first browser extension that enhances web novel and fanfiction reading with the AI provider of your choice",
	"scripts": {
		"build": "node dev/build.js",
		"build:firefox": "node dev/build.js --firefox",
		"build:chromium": "node dev/build.js --chromium",
		"package": "node dev/build.js --package",
		"package:firefox": "node dev/build.js --firefox --package",
		"package:chromium": "node dev/build.js --chromium --package",
		"package:source": "node dev/build.js --source",
		"publish": "npm run commits:write && node dev/build.js --package --source",
		"publish:stores": "node dev/publish-addon-stores.js",
		"release:archive": "node dev/publish-release-assets.js",
		"update-domains": "node dev/build.js --update",
		"watch": "npm run build && node dev/watch.js",
		"validate:backup-contract": "node dev/validate-backup-compat.js",
		"docs:visualize": "node dev/generate-doc-visualizers.js",
		"docs:graphify": "graphify update",
		"fonts:fetch": "node dev/fetch-fonts.js",
		"emoji:scan": "node dev/emoji-tools.js scan",
		"emoji:repair": "node dev/emoji-tools.js repair",
		"emoji:repair:dry": "node dev/emoji-tools.js repair --dry-run",
		"emoji:report:popup": "node dev/emoji-tools.js report --file=src/popup/popup.html",
		"emoji:encode:src": "node dev/emoji-tools.js encode --roots=src",
		"commits:all": "node dev/commit-history.js --all",
		"commits:write": "node dev/commit-history.js --all --output docs/release/commit-history.md",
		"commits:versions": "node dev/commit-history.js --versions",
		"test": "node --test \"tests/**/*.test.mjs\"",
		"lint": "eslint src/**/*.js",
		"lint:fix": "eslint src/**/*.js --fix",
		"format": "prettier --write \"src/**/*.{js,json,css,html}\"",
		"format:check": "prettier --check \"src/**/*.{js,json,css,html}\""
	},
	"dependencies": {
		"webextension-polyfill": "^0.12.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"archiver": "^8.0.0",
		"dotenv": "^17.4.2",
		"eslint": "^10.8.1",
		"globals": "^17.11.0",
		"linkedom": "^0.18.13",
		"prettier": "^3.9.6"
	},
	"readme": "README.md",
	"author": {
		"name": "VKrishna04",
		"email": "github@vkrishna04.me",
		"url": "https://vkrishna04.me"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Life-Experimentalist/RanobeGemini.git"
	},
	"bugs": {
		"url": "https://github.com/Life-Experimentalist/RanobeGemini/issues"
	},
	"homepage": "https://github.com/Life-Experimentalist/RanobeGemini#readme",
	"private": true,
	"type": "commonjs",
	"engines": {
		"node": ">=22.13.0"
	},
