# Line endings: LF in the repository and in the working tree on every OS,
# so the code runs as is when copied to macOS or Linux.
* text=auto eol=lf

# Windows batch files need CRLF to run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.jar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
