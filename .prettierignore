dist/
releases/
graphify-out/
node_modules/

# Vendored third-party code. `npm run format` globs src/**/*.js, which picked
# this up and expanded the minified bundle from one line to 556 — a diff nobody
# can review against upstream, in a file we do not own. It ships verbatim as
# whatever webextension-polyfill published; it is not ours to restyle.
src/lib/browser-polyfill.min.js

# Partly generated. `dev/build.js` rewrites the `matches` arrays from the
# handler files and propagates the version out of manifest-chromium.json (the
# single source of truth) into the other one, re-serializing with
# JSON.stringify, which expands arrays Prettier would keep inline. Without this,
# every release bump leaves the firefox manifest unformatted and CI's
# format:check goes red on the release commit itself. ESLint already ignores
# both files for the same reason.
src/manifest-chromium.json
src/manifest-firefox.json

# Generated by `npm run fonts:fetch`, and regenerated verbatim every time it
# runs. Prettier only wants to wrap the `unicode-range` lists, which come
# straight from Google's own stylesheet — formatting it here would just make the
# next fetch show up as a diff.
src/fonts/fonts.css
